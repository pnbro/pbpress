# PBPress nginx 설정 예시
#
# nginx 는 .htaccess 를 읽지 않으므로, PHP 사이트라면 공통으로 쓰는 아래 "try_files 한 줄"만 서버 설정에 있으면 됩니다.
# (nginx 호스팅·서버 패널의 WordPress 용 기본 설정과 같습니다. 이미 있으면 추가 작업 없음)
#
# 나머지는 pb-config.php 에서 끝납니다.
#   define("PB_SERVER_TYPE", "nginx");                          // .htaccess 를 만들거나 확인하지 않음
#   define("PB_FILE_UPLOAD_STORAGE_PATH", "../private/uploads"); // 업로드를 웹 폴더 밖에 저장 → 모든 첨부파일이 권한 확인을 거침
#
# 업로드 저장 위치를 지정하지 않으면 관리자 대시보드에 빨간 경고가 표시됩니다.

server {
	listen 80;
	server_name example.com;
	root /var/www/pbpress;   # PBPress 폴더 (index.php 가 있는 곳)
	index index.php;

	# ★ 필수: 실제 파일이 아니면 index.php 로 (사이트·관리자·/uploads 모두 PBPress 가 처리)
	#   하위 폴더(예: /pbpress/)에 설치했다면: location /pbpress/ { try_files $uri $uri/ /pbpress/index.php?$args; }
	location / {
		try_files $uri $uri/ /index.php?$args;
	}

	# PHP 실행 (호스팅 기본값을 그대로 쓰면 됩니다)
	location ~ \.php$ {
		try_files $uri =404;
		include fastcgi_params;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		fastcgi_pass unix:/run/php/php-fpm.sock;   # 또는 127.0.0.1:9000
	}

	# (선택) 숨김 파일(.git 등) 차단
	# location ~ /\.(?!well-known/) { deny all; }

	# (선택) 기존 공개 uploads 폴더에 옛 파일이 남아 있고 아직 옮기지 못했다면, 아래 규칙으로 PBPress 를 거치게 할 수 있습니다.
	# location ^~ /uploads/ { rewrite ^ /index.php last; }
}

# 참고: root 대신 alias 로 설치하면 경로 계산이 어긋나므로 root 방식을 사용하세요.
